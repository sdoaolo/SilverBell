SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=                    # Solapi에 사전 등록한 발신번호
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
SESSION_SECRET=                   # 32바이트 이상 랜덤
OTP_PEPPER=                       # 랜덤
CRON_SECRET=                      # 랜덤
PHONE_ENC_KEY=                    # 32바이트 랜덤 base64 (전화번호 암호화). 잃어버리면 번호 복구 불가
PHONE_HASH_KEY=                   # 32바이트 랜덤 base64 (전화번호 검색용 해시). ENC 키와 다른 값
BOOTSTRAP_SUPER_ADMIN_PHONES=     # 첫 super_admin 번호(콤마 구분). 이후 관리자는 앱에서 추가
ALLOW_PHONES=                     # 콤마 구분, 시연용 팀원 번호. 비면 전부 거부, '*'면 전체 허용
DEMO_MODE=true

# 키 교체 시에만: 예전 키를 버전 번호와 함께 보관 (예: PHONE_ENC_KEY_V1=...)
# PHONE_ENC_KEY_V1=
